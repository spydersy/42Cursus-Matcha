# ─────────────────────────────────────────────────────────────
# Matcha — environment template. Copy to .env and fill in:
#   cp .env.example .env
# NEVER commit .env (it's git-ignored).
# ─────────────────────────────────────────────────────────────

# ─── Flask ──────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex
# 1 = dev server with auto-reload; 0 = production mode
FLASK_DEBUG=1

# ─── Neo4j ──────────────────────────────────────────────────
# Host dev value. docker compose overrides this to bolt://neo4j:7687
# for the backend container automatically.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j requires ≥ 8 chars. Used by `docker compose` for the DB container.
NEO4J_PASSWORD=matcha-dev-password

# ─── Mail (Mailpit in dev) ──────────────────────────────────
# Host dev value. docker compose overrides MAIL_HOST to `mailpit`
# for the backend container automatically.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@matcha.local

# ─── URLs ───────────────────────────────────────────────────
# Used in verification / password-reset email links.
FRONTEND_URL=http://localhost:5173

# Browser-side URLs for the frontend container (docker compose).
# For host dev (`npm run dev`), copy these two into frontend/.env instead.
# API is on 5001 because macOS AirPlay Receiver occupies 5000.
VITE_API_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# ─── Uploads ────────────────────────────────────────────────
# Profile pictures — relative to backend/ (container: /app/uploads volume).
UPLOAD_FOLDER=uploads
